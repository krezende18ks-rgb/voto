function CourseManagement() {
  const { user, courses = [], fetchData, showToast, role, getHeaders } = useContext(AppContext);
  const availableCourses = role === 'coordinator' ? courses.filter(c => c === user?.course) : courses;
  const [turmas, setTurmas] = useState([]);
  const [newCourse, setNewCourse] = useState('');
  const [newTurma, setNewTurma] = useState('');
  const [selectedCourse, setSelectedCourse] = useState('');

  useEffect(() => {
    fetchTurmas();
  }, []);

  const fetchTurmas = async () => {
    const res = await apiFetch(`${API_URL}/turmas`);
    if (res.ok) setTurmas(await res.json());
  };

  const addCourse = async () => {
    if (!newCourse) return;
    await apiFetch(`${API_URL}/courses`, {
      method: 'POST',
      headers: getHeaders(),
      body: JSON.stringify({ name: newCourse })
    });
    setNewCourse(''); fetchData(); showToast('Curso adicionado');
  };

  const removeCourse = async (courseName) => {
    if (!confirm(`Remover curso ${courseName}?`)) return;
    try {
      const res = await apiFetch(`${API_URL}/courses/${encodeURIComponent(courseName)}`, {
        method: 'DELETE',
        headers: getHeaders()
      });
      if (!res.ok) throw new Error();
      showToast('Curso removido com sucesso');
      fetchData();
      fetchTurmas();
    } catch {
      showToast('Erro ao remover curso', 'error');
    }
  };

  const addTurma = async () => {
    if (!newTurma || !selectedCourse) { showToast('Selecione o curso e nome da turma', 'error'); return; }
    await apiFetch(`${API_URL}/turmas`, {
      method: 'POST',
      headers: getHeaders(),
      body: JSON.stringify({ name: newTurma, course: selectedCourse })
    });
    setNewTurma(''); fetchTurmas(); showToast('Turma adicionada');
  };

  const removeTurma = async (turma, curso) => {
    if (!confirm(`Remover turma ${turma} do curso ${curso}?`)) return;
    await apiFetch(`${API_URL}/turmas?name=${turma}&course=${curso}`, {
      method: 'DELETE',
      headers: getHeaders()
    });
    fetchTurmas(); showToast('Turma removida');
  };

  return (
    <div>
      <h2>Gerenciamento de Cursos e Turmas</h2>

      {role === 'rector' && (
        <>
          <div className="card">
            <div className="card-header">Adicionar Curso</div>
            <div style={{ display: 'flex', gap: '8px', marginBottom: '16px' }}>
              <input value={newCourse} onChange={e => setNewCourse(e.target.value)} placeholder="Nome do Curso" />
              <button className="primary" onClick={addCourse}>Adicionar Curso</button>
            </div>
          </div>

          <div className="card">
            <div className="card-header">Cursos Cadastrados</div>
            <table>
              <thead><tr><th>Curso</th><th>Ações</th></tr></thead>
              <tbody>
                {courses.map(c => (
                  <tr key={c}>
                    <td>{c}</td>
                    <td>
                      <button onClick={() => removeCourse(c)} style={{ background: 'none', border: 'none', color: 'red', cursor: 'pointer', fontWeight: 600 }}>Remover</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}

      <div className="card">
        <div className="card-header">Adicionar Turma</div>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr auto', gap: '8px', marginBottom: '16px' }}>
          <select value={selectedCourse} onChange={e => setSelectedCourse(e.target.value)}>
            <option value="">Selecione o Curso</option>
            {availableCourses.map(c => <option key={c} value={c}>{c}</option>)}
          </select>
          <input value={newTurma} onChange={e => setNewTurma(e.target.value)} placeholder="Nome da Turma" />
          <button className="primary" onClick={addTurma}>Adicionar Turma</button>
        </div>
      </div>

      <div className="card">
        <div className="card-header">Turmas Cadastradas</div>
        <table>
          <thead><tr><th>Curso</th><th>Turma</th><th>Ações</th></tr></thead>
          <tbody>
            {turmas.map(t => (
              <tr key={`${t.course}-${t.name}`}>
                <td>{t.course}</td>
                <td>{t.name}</td>
                <td>
                  <button onClick={() => removeTurma(t.name, t.course)} style={{ background: 'none', border: 'none', color: 'red', cursor: 'pointer', fontWeight: 600 }}>Remover</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}

