function Blockchain() {
  const { blockchain = [], showToast } = useContext(AppContext);
  const [integrity, setIntegrity] = useState(null);
  const [verifying, setVerifying] = useState(false);

  const verifyIntegrity = async () => {
    setVerifying(true);
    try {
      const res = await apiFetch(`${API_URL}/blockchain/verify`);
      const result = await res.json();
      setIntegrity(result);
      if (result.isValid) {
        showToast('Blockchain íntegra!');
      } else {
        showToast(`Erro de integridade no bloco ${result.errorBlock}`, 'error');
      }
    } catch {
      showToast('Erro ao verificar integridade', 'error');
    } finally {
      setVerifying(false);
    }
  };

  return (
    <div>
      <h2>Registro Blockchain</h2>
      <div className="card">
        <div className="card-header" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          Informações da Cadeia
          <button className="primary" onClick={verifyIntegrity} disabled={verifying} style={{ width: 'auto' }}>
            {verifying ? 'Verificando...' : '🔍 Verificar Integridade'}
          </button>
        </div>
        <p><strong>Blocos:</strong> {blockchain.length}</p>
        <p><strong>Último Hash:</strong> <code style={{ fontSize: '11px', wordBreak: 'break-all' }}>{blockchain[blockchain.length - 1]?.hash || '-'}</code></p>
        {integrity && (
          <p>
            <strong>Integridade:</strong>{' '}
            <span style={{ color: integrity.isValid ? 'var(--success)' : 'var(--critical)', fontWeight: 600 }}>
              {integrity.isValid ? 'Válida' : `Corrompida (Erro no bloco ${integrity.errorBlock})`}
            </span>
          </p>
        )}
      </div>
      <div className="card">
        <div className="card-header">Blocos Registrados</div>
        {blockchain.map(b => (
          <div key={b.idx} style={{ background: 'var(--bg-tertiary)', padding: '12px', borderRadius: '6px', marginBottom: '12px', fontSize: '12px', fontFamily: 'monospace' }}>
            <div style={{ fontWeight: 600, marginBottom: '6px', fontSize: '14px' }}>Bloco #{b.idx}</div>
            <div><strong>Hash:</strong> {b.hash}</div>
            <div><strong>Hash Anterior:</strong> {b.previousHash}</div>
            <div><strong>Dados:</strong> {b.data?.type || 'Voto anônimo'}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

function StudentManagement() {
  const { user, role, usersList = [], showToast, fetchData, courses = [], getHeaders } = useContext(AppContext);
  const availableCourses = role === 'coordinator' ? courses.filter(c => c === user?.course) : courses;
  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [matric, setMatric] = useState('');
  const [selectedCourse, setSelectedCourse] = useState('');
  const [selectedTurma, setSelectedTurma] = useState('');
  const [availableTurmas, setAvailableTurmas] = useState([]);

  useEffect(() => {
    if (selectedCourse) {
      apiFetch(`${API_URL}/turmas?course=${selectedCourse}`)
        .then(res => res.json())
        .then(data => setAvailableTurmas(data))
        .catch(() => setAvailableTurmas([]));
    } else {
      setAvailableTurmas([]);
      setSelectedTurma('');
    }
  }, [selectedCourse]);

  const addStudent = async () => {
    if (!name || !email || !password || !matric || !selectedCourse || !selectedTurma) {
      showToast('Preencha nome, email, senha, curso e turma', 'error');
      return;
    }
    try {
      const res = await apiFetch(`${API_URL}/users`, {
        method: 'POST',
        headers: getHeaders(),
        body: JSON.stringify({ name, email, password, role: 'voter', matric, cClass: selectedTurma, course: selectedCourse })
      });
      if (!res.ok) throw new Error();
      showToast('Aluno adicionado com sucesso');
      fetchData();
      setName(''); setEmail(''); setPassword(''); setMatric(''); setSelectedCourse(''); setSelectedTurma('');
    } catch {
      showToast('Erro ao adicionar aluno', 'error');
    }
  };

  const removeStudent = async (email) => {
    if (!confirm(`Remover aluno ${email}?`)) return;
    try {
      const res = await apiFetch(`${API_URL}/users/${encodeURIComponent(email)}`, { method: 'DELETE', headers: getHeaders() });
      if (!res.ok) throw new Error();
      showToast('Aluno removido com sucesso');
      fetchData();
    } catch {
      showToast('Erro ao remover aluno', 'error');
    }
  };

  const voters = usersList.filter(u => u.role === 'voter');

  return (
    <div>
      <h2>Gerenciamento de Alunos</h2>

      <div className="card">
        <div className="card-header">Adicionar Aluno</div>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px' }}>
          <input value={name} onChange={e => setName(e.target.value)} placeholder="Nome" />
          <input value={email} onChange={e => setEmail(e.target.value)} placeholder="Email" />
          <input value={password} onChange={e => setPassword(e.target.value)} placeholder="Senha" type="password" />
          <input value={matric} onChange={e => setMatric(e.target.value)} placeholder="Matrícula" />
          <select value={selectedCourse} onChange={e => setSelectedCourse(e.target.value)}>
            <option value="">Selecione o Curso</option>
            {availableCourses.map(c => <option key={c} value={c}>{c}</option>)}
          </select>
          <select value={selectedTurma} onChange={e => setSelectedTurma(e.target.value)} disabled={!selectedCourse}>
            <option value="">Selecione a Turma</option>
            {availableTurmas.map(t => <option key={t.name} value={t.name}>Turma {t.name}</option>)}
          </select>
          <button className="primary" onClick={addStudent}>Adicionar Aluno</button>
        </div>
      </div>

      <div className="card">
        <div className="card-header">Alunos Cadastrados</div>
        <table>
          <thead>
            <tr><th>Nome</th><th>Email</th><th>Matrícula</th><th>Curso</th><th>Turma</th><th>Ações</th></tr>
          </thead>
          <tbody>
            {voters.map(v => (
              <tr key={v.email}>
                <td>{v.name}</td>
                <td>{v.email}</td>
                <td>{v.matric || '-'}</td>
                <td>{v.course || '-'}</td>
                <td>{v.class || '-'}</td>
                <td>
                  <button onClick={() => removeStudent(v.email)} style={{ background: 'none', border: 'none', color: 'red', cursor: 'pointer', fontWeight: 600 }}>Remover</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}

