function CandidateModal() {
  const { user, role, setShowCandidateModal, showToast, courses = [], fetchData, getHeaders } = useContext(AppContext);
  const availableCourses = role === 'coordinator' ? courses.filter(c => c === user?.course) : courses;
  const [name, setName] = useState('');
  const [matric, setMatric] = useState('');
  const [phone, setPhone] = useState('');
  const [email, setEmail] = useState('');
  const [cClass, setCClass] = useState('');
  const [selectedCourse, setSelectedCourse] = useState('');
  const [position, setPosition] = useState('leader');
  const [availableTurmas, setAvailableTurmas] = useState([]);

  useEffect(() => {
    if (selectedCourse) {
      apiFetch(`${API_URL}/turmas?course=${selectedCourse}`)
        .then(res => res.json())
        .then(data => setAvailableTurmas(data))
        .catch(() => setAvailableTurmas([]));
    } else {
      setAvailableTurmas([]);
      setCClass('');
    }
  }, [selectedCourse]);

  const handleAdd = async () => {
    if (!name || !matric || !selectedCourse || !cClass) {
      showToast('Preencha os campos obrigatórios', 'error');
      return;
    }
    const newCand = { id: 'cand_' + Date.now(), name, matric, phone, email, class: cClass, course: selectedCourse, position };
    try {
      const response = await apiFetch(`${API_URL}/candidates`, {
        method: 'POST',
        headers: getHeaders(),
        body: JSON.stringify(newCand)
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(result.error || 'Não foi possível cadastrar o candidato.');
      }
      setShowCandidateModal(false);
      showToast('Candidato adicionado!');
      await fetchData();
    } catch (error) {
      showToast(error.message || 'Erro ao cadastrar candidato.', 'error');
    }
  };

  return (
    <div style={{ position: 'fixed', top: 0, left: 0, width: '100%', height: '100%', background: 'rgba(0,0,0,0.5)', display: 'flex', justifyContent: 'center', alignItems: 'center', zIndex: 1000 }}>
      <div className="card" style={{ width: '400px', background: 'var(--bg-primary)' }}>
        <div className="card-header">Adicionar Candidato</div>
        <div className="form-group"><label>Nome</label><input value={name} onChange={e => setName(e.target.value)} /></div>
        <div className="form-group"><label>Matrícula</label><input value={matric} onChange={e => setMatric(e.target.value)} /></div>
        <div className="form-group"><label>Telefone</label><input value={phone} onChange={e => setPhone(e.target.value)} /></div>
        <div className="form-group"><label>E-mail</label><input value={email} onChange={e => setEmail(e.target.value)} /></div>
        <div className="form-group"><label>Curso</label>
          <select value={selectedCourse} onChange={e => setSelectedCourse(e.target.value)}>
            <option value="">Selecione o Curso</option>
            {availableCourses.map(c => <option key={c} value={c}>{c}</option>)}
          </select>
        </div>
        <div className="form-group"><label>Turma</label>
          <select value={cClass} onChange={e => setCClass(e.target.value)} disabled={!selectedCourse}>
            <option value="">Selecione a Turma</option>
            {availableTurmas.map(t => <option key={t.name} value={t.name}>Turma {t.name}</option>)}
          </select>
        </div>
        <div className="form-group"><label>Cargo</label>
          <select value={position} onChange={e => setPosition(e.target.value)}>
            <option value="leader">Líder</option>
            <option value="viceLeader">Vice-Líder</option>
          </select>
        </div>
        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '8px' }}>
          <button onClick={() => setShowCandidateModal(false)}>Cancelar</button>
          <button className="primary" onClick={handleAdd}>Adicionar</button>
        </div>
      </div>
    </div>
  );
}

