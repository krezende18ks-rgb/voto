    ]
  };

  return (
    <nav className="sidebar" aria-label="Navegação principal">
      {(items[role] || []).map(item => (
        <button type="button" key={item.id} className={`nav-item ${view === item.id ? 'active' : ''}`} aria-current={view === item.id ? 'page' : undefined} onClick={() => setView(item.id)}>
