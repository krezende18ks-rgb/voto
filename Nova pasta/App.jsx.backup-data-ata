  const { role, view, setView } = useContext(AppContext);
  const items = {
    voter: [{ id: 'voting', label: '✅ Votar' }],
    teacher: [{ id: 'dashboard', label: '📊 Dashboard' }, { id: 'candidates', label: '🎯 Candidatos' }],
    coordinator: [
      { id: 'dashboard', label: '📊 Dashboard' },
      { id: 'candidates', label: '🎯 Candidatos' },
      { id: 'students', label: '👨‍🎓 Alunos' },
      { id: 'teachers', label: '👨‍🏫 Professores' },
      { id: 'courseManagement', label: '🏫 Turmas' },
      { id: 'blockchain', label: '🔗 Blockchain' },
      { id: 'ata', label: '📄 Ata' }
    ],
    rector: [
      { id: 'dashboard', label: '📊 Dashboard' },
      { id: 'monitoring', label: '👁️ Monitoramento' },
      { id: 'students', label: '👨‍🎓 Alunos' },
      { id: 'teachers', label: '👨‍🏫 Professores' },
      { id: 'usersManagement', label: '👥 Coordenadores' },
      { id: 'courseManagement', label: '🏫 Cursos e Turmas' },
