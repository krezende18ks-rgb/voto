function UsersManagement() {
  const {
    role, usersList = [], courses = [],
    showToast, fetchData, getHeaders
  } = useContext(AppContext);

  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [selectedCourse, setSelectedCourse] = useState('');

  if (role !== 'rector') {
    return <div><h2>Acesso não autorizado</h2></div>;
  }

  const addCoordinator = async () => {
    if (!name.trim() || !email.trim() || !password || !selectedCourse) {
      showToast('Preencha todos os campos.', 'error');
      return;
    }

    if (password.length < 8) {
      showToast('A senha deve ter pelo menos 8 caracteres.', 'error');
      return;
    }

    try {
      const res = await apiFetch(`${API_URL}/users`, {
        method: 'POST',
        headers: getHeaders(),
        body: JSON.stringify({
          name: name.trim(),
          email: email.trim(),
          password,
          role: 'coordinator',
          course: selectedCourse
        })
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Erro ao cadastrar coordenador.');
      }

      showToast('Coordenador cadastrado com sucesso!');
      setName('');
      setEmail('');
      setPassword('');
      setSelectedCourse('');
      await fetchData();
    } catch (err) {
      showToast(err.message || 'Erro ao cadastrar coordenador.', 'error');
    }
  };

  const removeCoordinator = async (coordinatorEmail) => {
    if (!confirm(`Remover o coordenador ${coordinatorEmail}?`)) return;

    try {
      const res = await apiFetch(
        `${API_URL}/users/${encodeURIComponent(coordinatorEmail)}`,
        {
          method: 'DELETE',
          headers: getHeaders()
        }
      );

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Erro ao remover coordenador.');
      }

      showToast('Coordenador removido com sucesso!');
      await fetchData();
    } catch (err) {
      showToast(err.message || 'Erro ao remover coordenador.', 'error');
    }
  };

  const coordinators = usersList.filter(u => u.role === 'coordinator');

  return (
    <div>
      <h2>Gerenciamento de Coordenadores</h2>

      <div className="card">
        <div className="card-header">Cadastrar Coordenador</div>

        <div style={{
          display: 'grid',
          gridTemplateColumns: '1fr 1fr',
          gap: '8px'
        }}>
          <input
            value={name}
            onChange={e => setName(e.target.value)}
            placeholder="Nome do coordenador"
          />

          <input
            type="email"
            value={email}
            onChange={e => setEmail(e.target.value)}
            placeholder="E-mail"
          />

          <input
            type="password"
            value={password}
            onChange={e => setPassword(e.target.value)}
            placeholder="Senha (mínimo 8 caracteres)"
          />

          <select
            value={selectedCourse}
            onChange={e => setSelectedCourse(e.target.value)}
          >
            <option value="">Selecione o curso</option>
            {courses.map(course => (
              <option key={course} value={course}>{course}</option>
            ))}
          </select>

          <button
            type="button"
            className="primary"
            onClick={addCoordinator}
          >
            Cadastrar Coordenador
          </button>
        </div>
      </div>

      <div className="card">
        <div className="card-header">Coordenadores Cadastrados</div>

        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Curso</th>
              <th>Ações</th>
            </tr>
          </thead>

          <tbody>
            {coordinators.map(coordinator => (
              <tr key={coordinator.email}>
                <td>{coordinator.name}</td>
                <td>{coordinator.email}</td>
                <td>{coordinator.course || '-'}</td>
                <td>
                  <button
                    type="button"
                    onClick={() => removeCoordinator(coordinator.email)}
                    style={{
                      background: 'none',
                      border: 'none',
                      color: 'red',
                      cursor: 'pointer',
                      fontWeight: 600
                    }}
                  >
                    Remover
                  </button>
                </td>
              </tr>
            ))}

            {coordinators.length === 0 && (
              <tr>
                <td colSpan="4">Nenhum coordenador cadastrado.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
