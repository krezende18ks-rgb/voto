}

function Dashboard() {
  const { user,role, votes = [], candidates = [], courses = [], turmas = [], votingStarted, setVotingStarted, votingEnded, setVotingEnded, showToast, setShowQrModal, setView, getHeaders } = useContext(AppContext);

  const startVoting = async () => {
    if (votingStarted) return;
    if (confirm('Iniciar votação?')) {
      try {
        const res = await apiFetch(`${API_URL}/election-status`, {
          method: 'POST',
          headers: getHeaders(),
          body: JSON.stringify({ key: 'started', value: true })
        });
        if (res.ok) {
          setVotingStarted(true);
          showToast('Votação iniciada!');
        } else {
          showToast('Erro ao iniciar votação', 'error');
        }
      } catch {
        showToast('Erro de conexão', 'error');
      }
    }
  };

  const endVoting = async () => {
    if (votingEnded) return;
    if (confirm('Encerrar votação?')) {
      try {
        const res = await apiFetch(`${API_URL}/election-status`, {
          method: 'POST',
          headers: getHeaders(),
          body: JSON.stringify({ key: 'ended', value: true })
        });
        if (res.ok) {
          setVotingEnded(true);
          await fetchData();
          showToast('Votação encerrada!');
          setView('ata');
        } else {
          showToast('Erro ao encerrar votação', 'error');
        }
      } catch {
        showToast('Erro de conexão', 'error');
      }
    }
  };

  // Se for coordenador, filtra votos pelo curso do coordenador
  const filteredVotes = role === 'coordinator' && user?.course
    ? votes.filter(v => v.course === user.course)
    : votes;

  const totalVotes = filteredVotes.length;
  const visibleTurmas = role === 'coordinator' && user?.course ? turmas.filter(t => t.course === user.course) : turmas;
  const pendingVotes = Math.max(0, (visibleTurmas.length * 15) - totalVotes);
  const totalClasses = visibleTurmas.length;
  const classesWithVotes = visibleTurmas.filter(t => votes.some(v => v.voterClass === t.name && v.course === t.course)).length;
  const completionPct = totalClasses > 0 ? Math.round((classesWithVotes / totalClasses) * 100) : 0;

  return (
    <div>
      <h2>Dashboard</h2>

      {role === 'rector' && (
        <div className="card" style={{ marginBottom: '20px' }}>
          <div className="card-header">Progresso Geral das Eleições</div>
          <div style={{ fontWeight: 600, marginBottom: '8px' }}>
            {classesWithVotes} de {totalClasses} turmas com votos registrados ({completionPct}%)
          </div>
          <div style={{ background: 'var(--bg-tertiary)', height: '24px', borderRadius: '6px', overflow: 'hidden' }}>
            <div style={{ transform: `scaleX(${completionPct / 100})`, transformOrigin: 'left', background: 'var(--accent)', height: '100%', transition: 'transform 0.3s ease' }}></div>
          </div>
        </div>
      )}

      {role === 'teacher' && (
        <div className="card" style={{ background: 'var(--accent-light)', border: '1px solid var(--accent)' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <div><strong>Controle da Votação</strong><p style={{ margin: '4px 0 0 0' }}>Encerre para gerar a ata.</p></div>
            <button className="primary" onClick={endVoting} disabled={votingEnded} style={{ background: votingEnded ? 'var(--success)' : 'var(--critical)' }}>
              {votingEnded ? '✅ Encerrada' : '🔴 Encerrar Votação'}
            </button>
          </div>
        </div>
      )}

      {role === 'coordinator' && (
        <div className="card" style={{ background: 'var(--accent-light)', border: '1px solid var(--accent)' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <div><strong>Controle da Votação - {user?.course || 'Curso não definido'}</strong></div>
            <div style={{ display: 'flex', gap: '8px' }}>
              <button className="primary" onClick={startVoting} disabled={votingStarted} style={{ background: 'var(--success)' }}>Iniciar</button>
              <button className="primary" onClick={endVoting} disabled={votingEnded} style={{ background: 'var(--critical)' }}>Encerrar</button>
            </div>
          </div>
        </div>
      )}

      {(role === 'teacher' || role === 'coordinator') && (
        <div style={{ marginBottom: '20px' }}>
          <button className="primary" onClick={() => setShowQrModal(true)}>📱 Gerar QR Code para Votação</button>
        </div>
      )}

      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '16px', marginBottom: '24px' }}>
        <div className="card" style={{ textAlign: 'center' }}><h3>{totalVotes}</h3><p>Total de Votos {role === 'coordinator' ? `(Curso ${user?.course || 'não definido'})` : ''}</p></div>
        <div className="card" style={{ textAlign: 'center' }}><h3>{totalVotes}</h3><p>Registrados</p></div>
        <div className="card" style={{ textAlign: 'center' }}><h3>{pendingVotes}</h3><p>Pendentes</p></div>
      </div>

      <div className="card">
        <div className="card-header">Cursos e Status</div>
        <table>
          <thead><tr><th>Curso</th><th>Total</th><th>Votantes</th><th>%</th></tr></thead>
          <tbody>
            {role === 'coordinator' ? (
               visibleTurmas.map(t => {
                  const count = filteredVotes.filter(v => v.voterClass === t.name && v.course === t.course).length;
                  const pct = 15 > 0 ? Math.round((count / 15) * 100) : 0;
                  return <tr key={`${t.course}-${t.name}`}><td>{t.course} · Turma {t.name}</td><td>15</td><td>{count}</td><td>{pct}%</td></tr>;
               })
            ) : (
              visibleTurmas.map(t => {
                const count = votes.filter(v => v.voterClass === t.name && v.course === t.course).length;
                const pct = 15 > 0 ? Math.round((count / 15) * 100) : 0;
                return <tr key={`${t.course}-${t.name}`}><td>{t.course} · Turma {t.name}</td><td>15</td><td>{count}</td><td>{pct}%</td></tr>;
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}

function Voting() {
  const { user, candidates = [], votes = [], hasVoted, votingStarted, votingEnded, fetchData, showToast, getHeaders } = useContext(AppContext);
  const [name, setName] = useState(user?.name || '');
  const [matric, setMatric] = useState(user?.matric || '');
  const [vClass, setVClass] = useState(user?.class || '');
  const [selectedLeader, setSelectedLeader] = useState(null);
  const [selectedViceLeader, setSelectedViceLeader] = useState(null);

  useEffect(() => {
    if (user) {
      setName(user.name || '');
      setMatric(user.matric || '');
      setVClass(user.class || '');

    }
  }, [user]);


  if (votingEnded) {
    return (
      <div>
        <h2>Votação</h2>
        <div className="card" style={{ textAlign: 'center', padding: '40px' }}>
          <div style={{ fontSize: '48px', marginBottom: '16px' }}>🔴</div>
          <h3>Votação Encerrada</h3>
          <p style={{ color: 'var(--fg-secondary)', marginTop: '8px' }}>A votação para esta turma já foi encerrada.</p>
        </div>
      </div>
    );
  }

  if (!votingStarted) {
    return (
      <div>
        <h2>Votação</h2>
        <div className="card" role="status" style={{ textAlign: 'center', padding: '40px' }}>
          <div style={{ fontSize: '48px', marginBottom: '16px' }}>🕒</div>
          <h3>Votação ainda não iniciada</h3>
          <p style={{ color: 'var(--fg-secondary)', marginTop: '8px' }}>Aguarde a abertura oficial da eleição.</p>
        </div>
      </div>
    );
  }

  if (hasVoted) {
    return (
      <div>
        <h2>Votação</h2>
        <div className="card" style={{ textAlign: 'center', padding: '40px' }}>
          <div style={{ fontSize: '48px', marginBottom: '16px' }}>✅</div>
          <h3>Voto Registrado com Sucesso!</h3>
          <p style={{ color: 'var(--fg-secondary)', marginTop: '8px' }}>Seu voto já foi computado e registrado de forma segura na blockchain para a Turma {vClass}.</p>
        </div>
      </div>
    );
  }

  const submitVote = async () => {
    if (!name || !matric || !vClass || !selectedLeader || !selectedViceLeader) {
      showToast('Preencha todos os campos e selecione os candidatos', 'error');
      return;
    }
    try {
      const res = await apiFetch(`${API_URL}/votes`, {
        method: 'POST',
        headers: getHeaders(),
        body: JSON.stringify({ leader: selectedLeader, viceLeader: selectedViceLeader })
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(result.error || 'Erro ao registrar voto');
      }
      showToast('Voto registrado com sucesso!');
      setSelectedLeader(null); setSelectedViceLeader(null);
      await fetchData();
    } catch (err) {
      showToast(err.message || 'Erro ao registrar voto', 'error');
    }
  };

  // Novos registros possuem class=turma e course=curso.
  // Registros antigos podem ter class=curso e course vazio; mantemos compatibilidade.
  const classCandidates = candidates.filter((candidate) =>
    isCandidateEligible(candidate, { class: vClass, course: user?.course })
  );
  const leaders = classCandidates.filter(c => c.position === 'leader');
  const viceLeaders = classCandidates.filter(c => c.position === 'viceLeader');

  return (
    <div>
      <h2>Votação</h2>
      <div className="card">
        <div className="card-header">Informações do Eleitor</div>
