import React, { useState, useEffect, createContext, useContext, useRef } from 'react';
import { isCandidateEligible, tallyResults } from './election.js';

// API same-origin: funciona no computador e em celulares conectados pela rede local.
const API_URL = '';
const AppContext = createContext();
let authToken = sessionStorage.getItem('authToken') || '';
const apiFetch = (url, options = {}) => {
  const headers = new Headers(options.headers || {});
  if (options.body && !headers.has('Content-Type')) headers.set('Content-Type', 'application/json');
  if (authToken) headers.set('Authorization', `Bearer ${authToken}`);
  return fetch(url, { ...options, headers }).then((response) => {
    if (response.status === 401 && authToken) {
      authToken = '';
      sessionStorage.removeItem('authToken');
      sessionStorage.removeItem('currentUser');
      window.dispatchEvent(new Event('classvote:unauthorized'));
    }
    return response;
  });
};

export default function App() {
  const [isLoggedIn, setIsLoggedIn] = useState(Boolean(sessionStorage.getItem('authToken') && sessionStorage.getItem('currentUser')));
  const [user, setUser] = useState(() => {
    try {
      return JSON.parse(sessionStorage.getItem('currentUser') || 'null');
    } catch {
      sessionStorage.removeItem('currentUser');
      sessionStorage.removeItem('authToken');
      authToken = '';
      return null;
    }
  });
  const [role, setRole] = useState(() => { try { return JSON.parse(sessionStorage.getItem('currentUser') || 'null')?.role || 'voter'; } catch { return 'voter'; } });
  const [hasVoted, setHasVoted] = useState(false);
  const [results, setResults] = useState([]);

  // Adiciona cabeçalhos de autenticação para as requisições
  const getHeaders = () => ({
    'Content-Type': 'application/json',
    ...(authToken ? { Authorization: `Bearer ${authToken}` } : {})
  });

  const [view, setView] = useState(role === 'voter' ? 'voting' : 'dashboard');
  const [theme, setTheme] = useState(localStorage.getItem('theme') || 'light');

  const [candidates, setCandidates] = useState([]);
  const [votes, setVotes] = useState([]);
  const [blockchain, setBlockchain] = useState([]);
  const [courses, setCourses] = useState([]);
  const [turmas, setTurmas] = useState([]);
  const [usersList, setUsersList] = useState([]);

  const [votingStarted, setVotingStarted] = useState(false);
  const [votingEnded, setVotingEnded] = useState(false);
  const [electionEndedAt, setElectionEndedAt] = useState(null);
  const [notification, setNotification] = useState({ show: false, message: '', type: 'success' });

  const [showCandidateModal, setShowCandidateModal] = useState(false);
  const [showUserModal, setShowUserModal] = useState(false);
  const [showQrModal, setShowQrModal] = useState(false);

  useEffect(() => {
    if (isLoggedIn) fetchData();
  }, [isLoggedIn]);

  useEffect(() => {
    const handleUnauthorized = () => { setIsLoggedIn(false); setUser(null); setRole('voter'); };
    window.addEventListener('classvote:unauthorized', handleUnauthorized);
    return () => window.removeEventListener('classvote:unauthorized', handleUnauthorized);
  }, []);

  useEffect(() => {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }, [theme]);

  const fetchData = async () => {
    try {
      
      const candsUrl = `${API_URL}/candidates`;
      const isVoter = user?.role === 'voter';
      const votesUrl = isVoter ? `${API_URL}/my-participation` : `${API_URL}/votes`;
      const usersUrl = isVoter ? null : `${API_URL}/users`;

      const [candsRes, votesRes, chainRes, coursesRes, turmasRes, usersRes, statusRes, resultsRes] = await Promise.all([
        apiFetch(candsUrl).catch(() => null),
        apiFetch(votesUrl).catch(() => null),
        isVoter ? Promise.resolve(null) : apiFetch(`${API_URL}/blockchain`).catch(() => null),
        apiFetch(`${API_URL}/courses`).catch(() => null),
        apiFetch(`${API_URL}/turmas`).catch(() => null),
        usersUrl ? apiFetch(usersUrl).catch(() => null) : Promise.resolve(null),
        apiFetch(`${API_URL}/election-status`).catch(() => null),
        isVoter ? Promise.resolve(null) : apiFetch(`${API_URL}/results`).catch(() => null)
      ]);

      if (candsRes && candsRes.ok) {
        const cands = await candsRes.json();
        setCandidates(cands);
      }
      if (votesRes && votesRes.ok) {
        const voteData = await votesRes.json();
        if (isVoter) setHasVoted(Boolean(voteData.voted)); else setVotes(voteData);
      }
      if (resultsRes && resultsRes.ok) setResults(await resultsRes.json());
      if (chainRes && chainRes.ok) setBlockchain(await chainRes.json());
      if (coursesRes && coursesRes.ok) setCourses(await coursesRes.json());
      if (turmasRes && turmasRes.ok) setTurmas(await turmasRes.json());
      if (usersRes && usersRes.ok) setUsersList(await usersRes.json());
      if (statusRes && statusRes.ok) {
        const status = await statusRes.json();
        setVotingStarted(status.started);
        setVotingEnded(status.ended);
        setElectionEndedAt(status.endedAt || null);
      }
    } catch (err) {
      console.warn('Erro ao buscar dados:', err);
    }
  };

  const showToast = (message, type = 'success') => {
    setNotification({ show: true, message, type });
    setTimeout(() => setNotification(prev => ({ ...prev, show: false })), 3000);
  };

  const toggleTheme = () => setTheme(prev => prev === 'dark' ? 'light' : 'dark');

  const logout = () => {
    sessionStorage.removeItem('authToken');
    sessionStorage.removeItem('currentUser');
    localStorage.removeItem('currentUser');
    localStorage.removeItem('isLoggedIn');
    localStorage.removeItem('userRole');
    authToken = '';
    setHasVoted(false);
    setIsLoggedIn(false);
    setUser(null);
    showToast('Logout realizado com sucesso');
  };

  if (!isLoggedIn) {
    return <LoginView setIsLoggedIn={setIsLoggedIn} setUser={setUser} setRole={setRole} setView={setView} showToast={showToast} />;
  }

  return (
    <AppContext.Provider value={{
      user, role, view, setView, theme, toggleTheme, logout,
      candidates, votes, results, blockchain, courses, turmas, usersList, hasVoted,
      votingStarted, setVotingStarted, votingEnded, setVotingEnded,
      electionEndedAt,
      showToast, fetchData, getHeaders,
      showCandidateModal, setShowCandidateModal,
      showUserModal, setShowUserModal,
      showQrModal, setShowQrModal
    }}>
      <div className="app-container">
        <a className="skip-link" href="#main-content">Pular para o conteúdo</a>
        <header>
          <h1 className="header-title">🗳️ Sistema de Votação Blockchain</h1>
          <div className="header-controls">
            <span className="role-badge">👤 {role === 'voter' ? 'Eleitor/Aluno' : role === 'teacher' ? 'Professor' : role === 'coordinator' ? 'Coordenador' : 'Reitor'} - {user?.name}</span>
            <button type="button" onClick={toggleTheme} aria-label={theme === 'dark' ? 'Ativar tema claro' : 'Ativar tema escuro'} title={theme === 'dark' ? 'Ativar tema claro' : 'Ativar tema escuro'}>{theme === 'dark' ? '☀️' : '🌙'}</button>
            <button onClick={logout}>🚪 Sair</button>
          </div>
        </header>

        <div className="main-content">
          <Sidebar />
          <main id="main-content" className="content-area" tabIndex={-1}>
            {view === 'dashboard' && <Dashboard />}
            {view === 'voting' && <Voting />}
            {view === 'candidates' && <Candidates />}
            {view === 'monitoring' && <Monitoring />}
            {view === 'blockchain' && <Blockchain />}
            {view === 'usersManagement' && <UsersManagement />}
            {view === 'students' && <StudentManagement />}
            {view === 'teachers' && <TeacherManagement />}
            {view === 'courseManagement' && <CourseManagement />}
            {view === 'ata' && <Ata />}
          </main>
        </div>
      </div>

      {showCandidateModal && <CandidateModal />}
      {showUserModal && <UserModal />}
      {showQrModal && <QrModal />}

      {notification.show && (
        <div role="status" aria-live="polite" aria-atomic="true" style={{
          position: 'fixed', bottom: '24px', right: '24px',
          background: notification.type === 'error' ? 'var(--critical)' : 'var(--success)',
          color: 'white', padding: '12px 24px', borderRadius: '8px',
          boxShadow: '0 4px 12px rgba(0,0,0,0.15)', zIndex: 2000, fontWeight: 500
        }}>
          {notification.message}
        </div>
      )}
    </AppContext.Provider>
  );
}

function LoginView({ setIsLoggedIn, setUser, setRole, setView, showToast }) {
  const [tabRole, setTabRole] = useState('voter');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [remember, setRemember] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  useEffect(() => {
    const remembered = localStorage.getItem('rememberedEmail');
    if (remembered) {
      setEmail(remembered);
      setRemember(true);
    }
  }, []);

  const handleLogin = async (e) => {
    e.preventDefault();
    setIsLoading(true);
    try {
      const res = await fetch(`${API_URL}/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, role: tabRole })
      });
      const result = await res.json();
      if (!res.ok) {
        showToast(result.error || 'Email ou senha incorretos', 'error');
        setIsLoading(false);
        return;
      }
      const userData = result.user;
      authToken = result.token;
      sessionStorage.setItem('authToken', result.token);
      sessionStorage.setItem('currentUser', JSON.stringify(userData));
      if (remember) localStorage.setItem('rememberedEmail', email);

      setUser(userData);
      setRole(tabRole);
      setView(tabRole === 'voter' ? 'voting' : 'dashboard');
      setIsLoggedIn(true);
      showToast(`Bem-vindo, ${userData.name}!`);
    } catch (err) {
      showToast('Erro ao conectar ao servidor', 'error');
      setIsLoading(false);
    }
  };

  return (
    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', minHeight: '100vh', width: '100%' }}>
      <div className="login-wrapper">
        <div className="login-branding">
          <div className="brand-icon">🗳️</div>
          <h1 className="brand-title">Sistema de Votação</h1>
          <p className="brand-desc">Votação segura e transparente com blockchain</p>
          <div className="brand-features" style={{ marginTop: '20px', textAlign: 'left', fontSize: '13px' }}>
            <div>✓ Votação segura e auditável</div>
            <div>✓ Registro imutável em blockchain</div>
            <div>✓ Acesso para múltiplos perfis</div>
            <div>✓ Monitoramento em tempo real</div>
          </div>
        </div>
        <div className="login-form-container">
          <div className="form-header">
            <h2 className="form-title">Bem-vindo</h2>
            <p className="form-subtitle">Faça login com suas credenciais</p>
          </div>
          <div className="role-tabs">
            {['voter', 'teacher', 'coordinator', 'rector'].map(r => (
              <button key={r} type="button" aria-pressed={tabRole === r} className={`role-tab ${tabRole === r ? 'active' : ''}`} onClick={() => setTabRole(r)}>
                {r === 'voter' ? '👨‍🎓 Aluno' : r === 'teacher' ? '👨‍🏫 Prof.' : r === 'coordinator' ? '👔 Coord.' : '🎓 Reitor'}
              </button>
            ))}
          </div>
          <form onSubmit={handleLogin}>
            <div className="form-group">
              <label htmlFor="login-email">Email</label>
              <input id="login-email" type="email" value={email} onChange={e => setEmail(e.target.value)} placeholder="seu@email.com" required />
            </div>
            <div className="form-group">
              <label htmlFor="login-password">Senha</label>
              <input id="login-password" type="password" value={password} onChange={e => setPassword(e.target.value)} placeholder="••••••••" required />
            </div>
            <div className="form-group" style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
              <input type="checkbox" id="remember" checked={remember} onChange={e => setRemember(e.target.checked)} style={{ width: 'auto' }} />
              <label htmlFor="remember" style={{ margin: 0 }}>Manter conectado</label>
            </div>
            <button type="submit" className="primary" disabled={isLoading}>
              {isLoading ? 'Entrando...' : 'Entrar'}
            </button>
          </form>
        </div>
      </div>
    </div>
  );
}

