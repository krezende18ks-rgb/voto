# PostgreSQL: use uma base exclusiva para o ClassVote
DATABASE_URL=postgresql://postgres:1230@localhost:5432/classvote

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=CHANGE_ME

# Em desenvolvimento local, deixe vazio. Em produção, informe origens HTTPS separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3000
DB_POOL_MAX=10
DATABASE_SSL=false
